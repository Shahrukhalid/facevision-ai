# FaceVision AI settings. Copy to .env and edit. Everything is optional.

# Network: listen on this computer only (recommended). See SECURITY.md before changing.
FV_HOST=127.0.0.1
FV_PORT=8600
# FV_ALLOW_REMOTE=1
# FV_ALLOWED_HOSTS=mypc.local

# Where the database, models and job outputs are stored (default: your OS application-data folder)
# FV_DATA_DIR=/path/to/folder

# Limits
FV_MAX_IMAGE_MB=20
FV_MAX_VIDEO_MB=1024
FV_MAX_BATCH_FILES=200
FV_JOB_WORKERS=1

# Disable all model downloads (fully offline)
FV_OFFLINE=0

FV_LOG_LEVEL=INFO
